(rules
 (processor
  (post
   (upgrade (lambda (x) x) :<=)))
 (plugin
  (: local-bind-handler))
 (mapping
  ;; RV32 寄存器宽度为 4 字节,栈帧槽位按字对齐
  (reg-bytes 4)
  (rs-in     (list ((in int) a) ((in float) fa)))
  (rs-out    (list ((out int) s) ((out float) fs)))
  (rs-in-out (append rs-in rs-out))

  ;; 以下都是本规则集的约定,寄存器分配算法本身不预设任何一项。
  ;; 寄存器池:按 ABI 角色分组,组内顺序即分配优先级。
  ;; 注意:mapping 值由规则引擎的过程式求值器处理,这里用 list 构造而不用 quote。
  (reg-pools   (list (cons arg   (list a0 a1 a2 a3 a4 a5 a6 a7))
                     (cons temp  (list t0 t1 t2 t3 t4 t5 t6))
                     (cons saved (list s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11))))
  ;; 寄存器符号的首字母(后跟数字),用于扫描 return 中的物理寄存器
  (reg-prefixes "sfta")
  ;; 调用指令标签
  (call-tags (map string->symbol (list ":f" ":s" "call")))
  ;; 控制结构标签:头部变量每轮重新求值,需要在节点末尾补记使用
  (control-tags (map string->symbol
                     (list "!for" "!while" "!do-while" "!if" "!if-else")))
  ;; 返回语句标签
  (return-tag (string->symbol "return")))
 (function
  (*** 重命名参数为寄存器(纯重命名,不再硬编码特定变量) ***)
  (:rename (lst cfglst)
           (rename lst cfglst))
  (*** 取 in/out 子句中的形参名 ***)
  (:param-names (io-clause)
                (if (null? io-clause)
                    '()
                    (map cadr (cdr io-clause))))
  (*** 获取重命名后的别名 ***)
  (:alasmap (lst)
            (safe second lst))
  (*** 取绑定列表中的目标值(寄存器名) ***)
  (:binding-values (bindings)
                   (map second bindings))
  (*** 取CDR并扁平化 ***)
  (:flatcdr (lst)
            (flatten (map cdr lst)))
  (*** 添加CDR列表 ***)
  (:appendcdr (lst)
              (append* (filter (lambda (t) (not (null? t)))
                               (append* (map (lambda (t) (safe cdr t)) lst)))))
  (*** 替换绑定 ***)
  (:replace (sexp bindings)
            (walk-replace sexp bindings))
  (*** 捕获输入输出 ***)
  (:catch-io (in-regs func-body ret-tag)
             (let* ((r (filter (lambda (x) (tag? x ret-tag))
                               func-body))
                    (in (if (null? in-regs) in-regs (list 'in (flatten (map cdr in-regs)))))
                    (out (if (null? r) r (list 'out (second (car r))))))
               (if (null? in)
                   (if (null? out)
                       '()
                       (list out))
                   (if (null? out)
                       (list in)
                       (list in out)))))
  (*** 符号添加后缀 ***)
  (:append-suffix (sym suffix)
                  (string->symbol (string-append (symbol->string sym) "-" suffix)))

  (*** 寄存器分配:为形参计算活跃区间并线性扫描分配物理寄存器 ***)
  (:allocate (params body reserved pools calls controls)
             (allocate-registers
              (live-intervals body params calls controls (register-pool pools 'arg))
              (register-pool pools 'saved)
              reserved))
  (*** 分配结果访问器 ***)
  (:alloc-regs  (alloc) (allocation-ref alloc 'regs))
  (:alloc-saved (alloc) (allocation-ref alloc 'saved))
  (:alloc-moves (alloc) (allocation-ref alloc 'moves))
  (:alloc-slots (alloc) (allocation-ref alloc 'slots))
  (*** 函数体中显式出现的被调用者保存寄存器 ***)
  (:body-saved (body pools)
               (registers-in body (register-pool pools 'saved)))
  (*** return 语句使用的寄存器(不参与序言保存,以免覆盖返回值) ***)
  (:ret-regs (body prefixes ret-tag)
             (return-registers body prefixes ret-tag))
  (*** 序言需要保存的寄存器:ra + 分配占用的 s* + 正文使用的 s* + out 声明寄存器 ***)
  (:prologue-regs (alloc-saved body-saved out-saved ret-used)
                  (unique
                   (append (list 'ra)
                           (filter (lambda (r) (not (member r ret-used)))
                                   (append alloc-saved body-saved out-saved)))))
  (*** 入口搬移:把入口实参寄存器中的跨调用活跃值搬到 s* ***)
  (:entry-moves (moves)
                (map (lambda (m) (list '<- (first m) (second m))) moves))
  (*** 溢出检查:当前规则层要求跨调用值都能放入 s* ***)
  (:ensure-no-spill (slots func-name)
                    (if (null? slots)
                        '()
                        (error
                         (format "寄存器分配失败:~a 需要栈溢出 ~a;请减少跨调用活跃变量或扩充 saved 寄存器池"
                                 func-name slots)))))

 (macro
  (*** 处理过程、函数、系统函数定义 ***)
  (p (procedure-name procedure-body)
     (label procedure-name)
     (:<= procedure-body))
  (f (func-name #:in in-regs #:out out-regs func-body)
     (*** 形参列表 ***)
     (: params (:param-names in-regs))
     (*** 入口实参寄存器(写入 signature,供调用方传参) ***)
     (: arg-maps (:rename (in-regs) rs-in))
     (: args     (:alasmap arg-maps))
     (*** out 声明沿用 rs-out 约定 ***)
     (: ret-maps  (:rename (out-regs) rs-out))
     (: ret-bindings (:alasmap ret-maps))
     (: out-saved (:binding-values ret-bindings))
     (*** 分配器:避开正文已使用的 s* 与 out 声明寄存器 ***)
     (: body-saved-orig (:body-saved func-body reg-pools))
     (: reserved (unique (append out-saved body-saved-orig)))
     (: alloc    (:allocate params func-body reserved reg-pools call-tags control-tags))
     (: slots    (:alloc-slots alloc))
     (:ensure-no-spill slots func-name)
     (*** 用分配结果替换函数体中的形参 ***)
     (: reg-maps (:alloc-regs alloc))
     (: fbody    (:replace func-body reg-maps))
     (*** 序言保存寄存器与入口搬移 ***)
     (: body-saved-new (:body-saved fbody reg-pools))
     (: ret-used (:ret-regs fbody reg-prefixes return-tag))
     (: alloc-saved (:alloc-saved alloc))
     (: regs  (:prologue-regs alloc-saved body-saved-new out-saved ret-used))
     (: alloc-moves (:alloc-moves alloc))
     (: moves (:entry-moves alloc-moves))
     (*** signature 从替换后的 fbody 提取,保证返回寄存器与实际代码一致 ***)
     (: io (:catch-io args fbody return-tag))
     (: epilogue (:append-suffix func-name "epilogue"))
     (!+ signature (append (list func-name) io))
     (label func-name)
     (note "函数序言")
     (push-stack regs)
     (:<= moves)
     (:<=
      fbody)
     (*** label epilogue ***)
     (note "函数尾声")
     (pop-stack regs)
     (ret))
  (s (func-name #:in in-regs #:out out-regs sysfunc-body)
     (: params (:param-names in-regs))
     (: arg-maps (:rename (in-regs) rs-in))
     (: args     (:alasmap arg-maps))
     (: ret-maps  (:rename (out-regs) rs-out))
     (: ret-bindings (:alasmap ret-maps))
     (: out-saved (:binding-values ret-bindings))
     (: body-saved-orig (:body-saved sysfunc-body reg-pools))
     (: reserved (unique (append out-saved body-saved-orig)))
     (: alloc    (:allocate params sysfunc-body reserved reg-pools call-tags control-tags))
     (: slots    (:alloc-slots alloc))
     (:ensure-no-spill slots func-name)
     (: reg-maps (:alloc-regs alloc))
     (: fbody    (:replace sysfunc-body reg-maps))
     (: io       (:catch-io args fbody return-tag))
     (!+ signature (append (list func-name) io))
     (label func-name)
     (:<= fbody)
     (ret))))
